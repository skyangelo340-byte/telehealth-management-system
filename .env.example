# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYMONGO QR PH INTEGRATION (Environment-Driven Test/Live Support)
# Mode: "test" (default sandbox) or "live" (production)
PAYMONGO_ENVIRONMENT="test"

# TEST MODE CREDENTIALS (When PAYMONGO_ENVIRONMENT="test"):
# Use official PayMongo sandbox test keys (sk_test_*, pk_test_*, whsk_test_*)
PAYMONGO_PUBLIC_KEY="pk_test_placeholder"
PAYMONGO_SECRET_KEY="sk_test_placeholder"
PAYMONGO_WEBHOOK_SECRET="whsk_test_placeholder"

# LIVE MODE REQUIREMENTS (When PAYMONGO_ENVIRONMENT="live"):
# To enable real-money PHP transactions, set PAYMONGO_ENVIRONMENT="live"
# and configure matching live credentials (sk_live_*, pk_live_*, whsk_live_*).
# PAYMONGO_ENVIRONMENT="live"
# PAYMONGO_PUBLIC_KEY="pk_live_placeholder"
# PAYMONGO_SECRET_KEY="sk_live_placeholder"
# PAYMONGO_WEBHOOK_SECRET="whsk_live_placeholder"

# AUTHORITATIVE CONSULTATION FEE IN PHP (Default: 10 = PHP 10.00 / 1000 centavos)
# Server source of truth for every PayMongo Payment Intent
PAYMONGO_CONSULTATION_FEE_PHP="10"
